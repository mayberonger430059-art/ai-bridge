# Copy to .env on the Windows machine ONLY. Never commit .env, never paste it into Notion or chat.
# Notion integration token: create an integration at notion.so/my-integrations,
# share ONLY the AI Bridge database with it, then paste the token here.
NOTION_API_KEY=
NOTION_DATABASE_ID=
# Optional: override the Notion API version (default 2022-06-28, the stable database-query version).
# NOTION_VERSION=2022-06-28
# Optional: 1 = allow the explicitly-labelled dryrun executor (plumbing test only, no model call).
# BRIDGE_ALLOW_DRYRUN=0
